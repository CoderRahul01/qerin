# Local-dev secrets for `wrangler dev`. Copy to `.dev.vars` (gitignored) and
# fill in real values — never commit `.dev.vars`. In production these are set
# with `wrangler secret put <NAME>`, not committed anywhere.

# ── Qerin wallets ───────────────────────────────────────────────────────────
# Every user gets their own Qerin wallet on each rail (Base, Solana), held in
# Coinbase CDP's key enclave. The user funds it from MetaMask / BO Wallet /
# Coinbase Wallet / Phantom, and their Qerin agent pays sources and Qerin's
# per-question fee from it. Qerin does NOT fund or front any shared wallet.
#
# "mainnet" = Base + Solana mainnet (real USDC)
# "testnet" = Base Sepolia + Solana devnet (free test USDC). Switches all rails
# together so a balance is never part real money, part test tokens.
QERIN_WALLET_ENV=mainnet

# Where the $0.08 per-question service fee is paid. Receive-only addresses —
# they never need funding. A rail without a treasury can still be funded and
# withdrawn from, but the agent won't run research on it.
QERIN_TREASURY_ADDRESS=
# Must already hold a USDC token account (receive any USDC there once).
QERIN_SOLANA_TREASURY_ADDRESS=

# Optional: free Helius/QuickNode/Alchemy RPC URLs to lift public rate limits.
QERIN_BASE_RPC_URL=
QERIN_SOLANA_RPC_URL=
# Set to "off" to hide Solana wallets on this deployment.
QERIN_SOLANA_WALLETS=

# Optional, legacy. Signs on-chain receipts on BOT Chain (tiny BOT gas, and
# non-fatal if empty) and honors prepaid credit bought before personal
# wallets existed. Research never depends on this wallet being funded.
QERIN_WALLET_PRIVATE_KEY=

# CDP API key (https://portal.cdp.coinbase.com). Authenticates the per-user
# Qerin wallets and the x402 facilitator that settles fees and withdrawals.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# CDP Wallet Secret. Required: with the API key above it creates and signs
# for every user's Qerin wallet (agentWallet.ts, solana/agentWallet.ts), and
# authenticates the x402 facilitator that settles payments gaslessly.
CDP_WALLET_SECRET=

# Free API key from https://build.nvidia.com (NVIDIA Developer Program, no
# credit card) — used for answer synthesis via NVIDIA NIM.
NVIDIA_API_KEY=

# Shared secret that gates the consumer /v1/answer and /v1/account* routes
# (balance-gated, not free — see accounts.ts). Generate with
# `openssl rand -hex 32`. Must match QERIN_INTERNAL_SECRET set on the
# frontend (apps/frontend), sent as the X-Qerin-Internal-Secret header.
QERIN_INTERNAL_SECRET=

# Deployed QerinReceiptRegistry contract address (apps/contracts). Optional —
# leave unset to skip on-chain receipt logging entirely. This is the
# fallback used when no network-specific var below is set (so a Base-only
# deployment can just set this one).
QERIN_REGISTRY_ADDRESS=

# Per-network overrides — a registry deployed on Base is a different contract
# address than one deployed on BOT Chain (separate chains, separate
# contracts). Set whichever networks you've actually deployed the registry
# to; recordReceipt.ts checks these before falling back to
# QERIN_REGISTRY_ADDRESS above. See apps/contracts/script/ for the deploy
# scripts per network.
QERIN_REGISTRY_ADDRESS_MAINNET=
QERIN_REGISTRY_ADDRESS_TESTNET=
QERIN_REGISTRY_ADDRESS_BOTCHAIN=
QERIN_REGISTRY_ADDRESS_BOTCHAIN_TESTNET=

# Firebase Admin SDK service account JSON, minified to a single line
# (project_id/client_email/private_key). Required — this is the entire
# database: accounts/balances/deposits (accounts.ts), the daily spend
# counters and audit log (spendGuard.ts), issued API keys (apiKeys.ts), and
# waitlist signups (waitlist.ts), all on Firestore's free Spark plan via the
# zero-dependency REST client in db.ts. No Postgres/Neon — that was an
# earlier design; if you see DATABASE_URL referenced anywhere else, it's
# stale.
FIREBASE_SERVICE_ACCOUNT=
